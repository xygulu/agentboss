# 自建中继配置样例。拷成 /etc/codeboss/selfhost.env 改完即可跑（见 docs/selfhost-relay.md）。
# 每行注释写「不配会怎样」。改完 systemctl restart codeboss-relay 生效。

# ── 必配 ─────────────────────────────────────────────
# 整包开关：1 = 关停官方专属端点（套餐/支付/官方 TTS/iOS/管理台），按 /r/caps 下发能力表
RELAY_SELFHOST=1
# 不配：不能用 /r/update 升级自己，也查/解绑不了设备（/r/admin_api/devices、/r/admin_api/device）
# 生成一行随机值：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_ADMIN_TOKEN=

# ── 大脑与耳朵（自备 key） ────────────────────────────
# DashScope key（阿里百炼）。不配：工头退「事实句」模式、按住说话（ASR）在手机上隐藏。
# llm 和 asr 共用这一个 key。
RELAY_DASHSCOPE_KEY=
# 大脑走 OpenAI 兼容接口的话在这里换：不配 = 用 DashScope 官方地址与默认模型
RELAY_LLM_BASE=
RELAY_LLM_MODEL=

# ── 注册通道（二选一，都不配 = 新用户没法注册） ────────
# 邮件验证码：四个都配才生效
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=465
RELAY_SMTP_USER=
RELAY_SMTP_PASS=
RELAY_SMTP_FROM=
# 阿里云短信：四件套。配了 SMS_ON 即开；与邮件二选一即可
#RELAY_ALI_AK_ID=
#RELAY_ALI_AK_SECRET=
#RELAY_ALI_ENDPOINT=
#RELAY_ALI_SIGN_NAME=
#RELAY_ALI_TEMPLATE_CODE=

# ── 规模与链路 ───────────────────────────────────────
# 最多接入的开发机台数。不配或 0 = 不设限（自建没有套餐系统，日额度全放开，
# 只有这一道闸；官方版默认 3）
RELAY_MAX_DEVICES=0
# TURN 中继列表（逗号分隔，turn:user:pass@host:port）。不配：出门在外只有打洞，
# 打洞失败就连不上——家庭宽带建议自架一个 coturn。
RELAY_TURN_URLS=
# 会话令牌加密钥。不配：重启后所有已登录手机掉线要重登。
# 生成一行：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_SESS_KEY=

# 端口和库路径不是环境变量，是启动参数：python3 relay.py --host 0.0.0.0 --port 8791 --db relay.db
# 安装脚本已写进 systemd unit，要改端口改 unit 文件。
